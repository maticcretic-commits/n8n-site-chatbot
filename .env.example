# Copy this file to .env and fill in your own values. Never commit the real .env.

# Production URL of the n8n "Chat Webhook" node (after activating the workflow)
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/chat

# URL the n8n workflow uses for KB lookup. For local practice, run
# `python server/mock_responder.py` and keep the default:
KB_LOOKUP_URL=http://localhost:8080

# Optional: webhook that receives human-handoff requests (e.g. a Slack/Teams incoming webhook)
HUMAN_WEBHOOK_URL=

# Local test server port for server/mock_responder.py
MOCK_PORT=8080

# OpenAI credential is attached inside n8n itself (never put keys here)
# OPENAI_API_KEY=
