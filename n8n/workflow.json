on that was NOT found in the knowledge base. Draft a short, warm reply (max 2 sentences) apologizing that you couldn't find the answer, and offer to connect them with a human. Do NOT invent clinic facts like prices or hours.","role":"system"},{"content":"={{ $('Extract Chat Input').item.json.message }}","role":"user"}]},"model":{"__rl":true,"cachedResultName":"gpt-4o-mini","mode":"list","value":"gpt-4o-mini"},"operation":"message","options":{},"resource":"text"},"position":[1560,420],"type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":1.8},{"id":"b8c9d0e1-f2a3-4b4c-5d6e-f7a8b9c0d1e2","name":"Format Handoff","parameters":{"assignments":{"assignments":[{"id":"hrep-1","name":"reply","type":"string","value":"={{ $json.content }}"},{"id":"hsid-1","name":"session_id","type":"string","value":"={{ $('Extract Chat Input').item.json.session_id }}"},{"id":"hh-1","name":"handoff","type":"boolean","value":true},{"id":"hsrc-1","name":"source","type":"string","value":"handoff"}]},"options":{}},"position":[1780,420],"type":"n8n-nodes-base.set","typeVersion":3.4},{"id":"c9d0e1f2-a3b4-4c5d-6e7f-a8b9c0d1e2f3","name":"Send KB Answer","parameters":{"options":{},"respondWith":"json","responseBody":"={\n  \"status\": \"ok\",\n  \"session_id\": \"{{ $json.session_id }}\",\n  \"reply\": \"{{ $json.reply }}\",\n  \"source\": \"{{ $json.source }}\"\n}"},"position":[1780,200],"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1},{"id":"d0e1f2a3-b4c5-4d6e-7f8a-b9c0d1e2f3a4","name":"Send Handoff","parameters":{"options":{},"respondWith":"json","responseBody":"={\n  \"status\": \"ok\",\n  \"session_id\": \"{{ $json.session_id }}\",\n  \"reply\": \"{{ $json.reply }}\",\n  \"source\": \"handoff\",\n  \"handoff\": true\n}"},"position":[2000,420],"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1}],"pinData":{},"settings":{"executionOrder":"v1"},"staticData":null}